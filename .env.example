# Copie para .env (ignorado pelo git) e troque os valores:  cp .env.example .env
# Este arquivo é versionado: NÃO coloque segredos reais aqui.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=cofre
# Mantenha igual ao "Username" de infra/pgadmin/servers.json (ou ajuste lá).
POSTGRES_USER=cofre
POSTGRES_PASSWORD=troque-me

# --- pgAdmin ------------------------------------------------------------------
PGADMIN_EMAIL=admin@cofre.local
PGADMIN_PASSWORD=troque-me

# --- Portas e interfaces publicadas no host -------------------------------------
# Postgres e pgAdmin ficam só em 127.0.0.1 por padrão. Atenção: portas publicadas
# pelo Docker passam por cima do ufw; não use 0.0.0.0 aqui no servidor.
BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
PGADMIN_PORT=5050

# MQTT precisa ser alcançável pelos ESP32 na rede, por isso o bind é separado.
MQTT_BIND_ADDRESS=0.0.0.0
MQTT_PORT=1883

# --- Exemplo: servidor Linux que já tem Mosquitto nativo (systemd) na 1883 ------
# O Mosquitto do container roda ao lado do nativo, em outra porta do host:
# MQTT_PORT=1884
# MQTT_BIND_ADDRESS=0.0.0.0
# BIND_ADDRESS=127.0.0.1
# (se o servidor também tiver um PostgreSQL nativo na 5432, use POSTGRES_PORT=5433)
