      "item": [
        {
          "name": "Rate limit sensível: regenerar credenciais repetidamente (429)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 429) {",
                  "    pm.test('429 com Retry-After', () => pm.response.to.have.header('Retry-After'));",
                  "    console.log('Retry-After (s):', pm.response.headers.get('Retry-After'));",
                  "} else {",
                  "    pm.test('ainda dentro do limite (200)', () => pm.response.to.have.status(200));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/admin/estantes/{{estanteId}}/credenciais",
            "description": "Criar estante + regenerar credenciais somam 10/min por admin. Clique em Send até receber 429 (ou rode só esta requisição no Runner com 12 iterações). Atenção: cada 200 troca as credenciais da estante de teste. As demais rotas /admin continuam funcionando (limite geral: 120/min por admin)."
          }
        }
      ]
    }
