{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Emissor": "cofre-eletronico-api",
    "Audiencia": "cofre-eletronico-app"
  },
  "Mqtt": {
    "Host": "",
    "Porta": 1883,
    "Usuario": "iot",
    "UsarTls": false,
    "KeepAliveSegundos": 30,
    "ReconexaoInicialSegundos": 1,
    "ReconexaoMaximaSegundos": 60,
    "TimeoutSegundos": 10,
    "LimiteConexaoEstavelSegundos": 30
  },
  "RateLimit": {
    "AuthCredenciais": {
      "Limite": 10,
      "JanelaSegundos": 60
    },
    "AuthSessao": {
      "Limite": 60,
      "JanelaSegundos": 60
    },
    "Admin": {
      "Limite": 120,
      "JanelaSegundos": 60
    },
    "AdminSensivel": {
      "Limite": 10,
      "JanelaSegundos": 60
    }
  }
}
